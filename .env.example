# Browser configuration (Firebase Console > Project settings > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Google Maps JavaScript API; restrict by domain and API in Google Cloud
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server only (Firebase Console > Service accounts > Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Vercel accepts the PEM string; local .env.local may use quoted escaped newlines
FIREBASE_PRIVATE_KEY=
# Private photo storage (server only; never NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=laundry-photos
# Comma-separated verified Google email addresses. Never NEXT_PUBLIC_.
ADMIN_EMAILS=
